# docker compose --env-file .env.deploy up --build
# Copy to `.env.deploy` (do not commit secrets).

MYSQL_DATABASE=my_review
MYSQL_USER=my_review
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=3306
API_PORT=8080

JWT_SECRET=change-me-to-a-long-random-string-32bytes-min
JWT_EXPIRATION_MS=86400000

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
# Comma-separated, trailing slashes required
KAKAO_REDIRECT_URIS=http://localhost:5173/auth/login/kakao/,myreview://auth/login/kakao/

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=http://localhost:5173/auth/login/google/,myreview://auth/login/google/

# Explicit origins in prod, e.g. https://localhost,capacitor://localhost
APP_CORS_ORIGINS=*
